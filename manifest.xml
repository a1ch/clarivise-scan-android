<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">

  <Id>4c8f3a2b-5d9e-4f0a-c3b2-7e6d4f8a9c0b</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>a1ch</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Email Evaluator"/>
  <Description DefaultValue="AI-powered phishing and spam detection for Outlook Mobile"/>

  <IconUrl DefaultValue="https://a1ch.github.io/outlook-email-evaluator-android/icons/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://a1ch.github.io/outlook-email-evaluator-android/icons/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/a1ch/outlook-email-evaluator-android"/>

  <AppDomains>
    <AppDomain>https://pikplhvawbhndijpkdbq.supabase.co</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://a1ch.github.io/outlook-email-evaluator-android/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
      <PhoneSettings>
        <SourceLocation DefaultValue="https://a1ch.github.io/outlook-email-evaluator-android/taskpane.html"/>
      </PhoneSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">

        <!-- Desktop / Outlook Web form factor (needed for sideloading and testing) -->
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                    <SupportsPinning>true</SupportsPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>

        <!-- Mobile form factor — shows up in Outlook on Android/iOS -->
        <MobileFormFactor>
          <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
            <Control xsi:type="MobileButton" id="mobileMsgReadOpenPaneButton">
              <Label resid="TaskpaneButton.Label"/>
              <Icon>
                <bt:Image size="25" scale="1" resid="Icon.16x16"/>
                <bt:Image size="25" scale="2" resid="Icon.32x32"/>
                <bt:Image size="25" scale="3" resid="Icon.80x80"/>
                <bt:Image size="32" scale="1" resid="Icon.32x32"/>
                <bt:Image size="32" scale="2" resid="Icon.80x80"/>
                <bt:Image size="48" scale="1" resid="Icon.80x80"/>
                <bt:Image size="48" scale="2" resid="Icon.80x80"/>
              </Icon>
              <Action xsi:type="ShowTaskpane">
                <SourceLocation resid="Taskpane.Url"/>
              </Action>
            </Control>
          </ExtensionPoint>
        </MobileFormFactor>

      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://a1ch.github.io/outlook-email-evaluator-android/icons/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://a1ch.github.io/outlook-email-evaluator-android/icons/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://a1ch.github.io/outlook-email-evaluator-android/icons/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://a1ch.github.io/outlook-email-evaluator-android/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://a1ch.github.io/outlook-email-evaluator-android/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Email Evaluator"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Analyze Email"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Analyze this email for phishing and spam threats using Claude AI"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>

</OfficeApp>
